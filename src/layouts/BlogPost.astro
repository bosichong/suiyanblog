---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import BackToTop from '../components/BackToTop.astro';
import TagList from '../components/TagList.astro';
import PostActions from '../components/PostActions.astro';
import { SITE_AUTHOR } from '../consts';
import { Icon } from 'astro-icon/components';
import AILabelBadge from '../components/AILabelBadge.astro';
import Webmentions from '../components/Webmentions.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	postId?: string;
};

const { title, description, time, updatedDate, heroImage, heroImageAlt, tags, ai_label, postId } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		
		<!-- JSON-LD 结构化数据 -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": title,
			"description": description,
			"datePublished": time,
			"dateModified": updatedDate || time,
			"author": {
				"@type": "Person",
				"name": SITE_AUTHOR
			},
			"publisher": {
				"@type": "Organization",
				"name": "碎言",
				"url": "https://www.suiyan.cc"
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": new URL(Astro.url.pathname, Astro.site).toString()
			},
			...(heroImage ? {
				"image": new URL(heroImage.src, Astro.site).toString()
			} : {})
		})} />
		
		<style>
			html, body {
				overflow-x: hidden;
			}
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
				overflow-x: hidden;
			}
			.prose :global(strong) {
				font-weight: 700;
				text-decoration: underline wavy;
				text-decoration-color: var(--accent-dark);
				text-underline-offset: 5px;
			}

			article {
				overflow-x: hidden;
				width: 100%;
			}
			article > div {
				overflow-x: hidden;
				width: 100%;
			}
			article pre,
			article table,
			article iframe {
				overflow-x: auto;
				max-width: 100%;
				display: block;
			}
			article pre code {
				display: block;
				overflow-x: auto;
			}
			article table code,
			article p code,
			article li code {
				word-break: break-all;
				white-space: normal;
			}
			article img {
				max-width: 100%;
				height: auto;
				display: block;
				margin: 1.5rem auto;
				border-radius: 0 12px 0 12px;
			}
			.prose table {
				width: 100%;
				border-collapse: collapse;
				margin: 1.5rem 0;
				font-size: 0.95rem;
				table-layout: fixed;
			}
			.prose table th,
			.prose table td {
				border: 1px solid var(--border-color);
				padding: 0.75rem 1rem;
				text-align: left;
				word-wrap: break-word;
				word-break: break-word;
				overflow-wrap: break-word;
				max-width: 0;
				overflow-x: hidden;
			}
			.prose table th code,
			.prose table td code {
				word-break: break-all;
				white-space: pre-wrap;
				display: inline-block;
				max-width: 100%;
			}
			.prose table th {
				background: rgba(var(--gray), 5%);
				font-weight: 600;
			}
			.prose table tr:hover {
				background: rgba(var(--gray), 3%);
			}
			.title {
				margin-bottom: 1.5em;
				padding: 1.5em 0;
				text-align: center;
			}
			.title h1 {
				margin: 0 0 0.75em 0;
				line-height: 1.3;
			}
			.meta {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
				margin-bottom: 0.75em;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.meta-item {
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
			}
			.meta-item svg {
				color: var(--accent);
			}
			.meta-item.updated {
				font-style: italic;
			}
			.meta .ai-label :global(.ai-badge) {
				padding: 0;
				background: none;
				border: none;
				border-radius: 0;
				gap: 0.25rem;
				font-size: inherit;
				font-weight: inherit;
				color: inherit;
			}
			@media (max-width: 720px) {
				.prose table {
					font-size: 0.85rem;
				}
				.prose table th,
				.prose table td {
					padding: 0.5rem 0.75rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main">
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={heroImageAlt || ''} />}
				</div>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="meta">
							<span class="meta-item">
								<Icon name="mdi:account" width={18} height={18} aria-hidden="true" />
								{SITE_AUTHOR}
							</span>
							<span class="meta-item ai-label">
								<AILabelBadge level={ai_label} />
							</span>
							<span class="meta-item">
								<Icon name="mdi:calendar" width={18} height={18} aria-hidden="true" />
								<FormattedDate date={time} />
							</span>
							{
								updatedDate && (
									<span class="meta-item updated">
										<Icon name="mdi:calendar-outline" width={18} height={18} aria-hidden="true" />
										更新于 <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<TagList tags={tags} showLabel={true} />
					</div>
					<div class="article-body">
						<slot />
					</div>
					<hr aria-hidden="true" />
					<Webmentions postId={postId || ''} title={title} />

					<PostActions postId={postId || ''} postPath={`/blog/${postId}`} />


				</div>
			</article>
		</main>
		<Footer />
		<BackToTop />
	</body>
</html>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import TagList from '../components/TagList.astro';
import PostActions from '../components/PostActions.astro';
import { SITE_AUTHOR } from '../consts';
import { Icon } from 'astro-icon/components';
import AILabelBadge from '../components/AILabelBadge.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	postId?: string;
};

const { title, description, time, updatedDate, heroImage, heroImageAlt, tags, ai_label, postId } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			motionMode="reveal"
		/>
		
		<!-- JSON-LD 结构化数据 -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": title,
			"description": description,
			"datePublished": time,
			"dateModified": updatedDate || time,
			"author": {
				"@type": "Person",
				"name": SITE_AUTHOR
			},
			"publisher": {
				"@type": "Organization",
				"name": "碎言",
				"url": "https://www.suiyan.cc"
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": new URL(Astro.url.pathname, Astro.site).toString()
			},
			...(heroImage ? {
				"image": new URL(heroImage.src, Astro.site).toString()
			} : {})
		})} />
		
		<style>
			html, body {
				overflow-x: hidden;
			}
			main {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border: 1px solid var(--border-soft);
				border-radius: var(--radius-square);
				background: var(--color-paper-muted);
				box-shadow: none;
			}
			.prose {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: var(--space-4);
				color: rgb(var(--gray-dark));
				overflow-x: hidden;
			}
			.prose :global(strong) {
				font-weight: 700;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-decoration-color: var(--border);
				text-underline-offset: 0.18em;
			}

			article {
				overflow-x: hidden;
				width: 100%;
			}
			article > div {
				overflow-x: hidden;
				width: 100%;
			}
			article pre,
			article table,
			article iframe {
				overflow-x: auto;
				max-width: 100%;
				display: block;
			}
			article pre code {
				display: block;
				overflow-x: auto;
			}
			article table code,
			article p code,
			article li code {
				word-break: break-all;
				white-space: normal;
			}
			article img {
				max-width: 100%;
				height: auto;
				display: block;
				margin: var(--space-8) auto;
				border: 1px solid var(--border-soft);
				border-radius: var(--radius-square);
				background: var(--color-paper-muted);
			}
			.prose table {
				width: 100%;
				border-collapse: collapse;
				margin: var(--space-8) 0;
				font-size: var(--text-small);
				table-layout: fixed;
			}
			.prose table th,
			.prose table td {
				border: 1px solid var(--border-color);
				padding: var(--space-3) var(--space-4);
				text-align: left;
				word-wrap: break-word;
				word-break: break-word;
				overflow-wrap: break-word;
				max-width: 0;
				overflow-x: hidden;
			}
			.prose table th code,
			.prose table td code {
				word-break: break-all;
				white-space: pre-wrap;
				display: inline-block;
				max-width: 100%;
			}
			.prose table th {
				background: var(--color-paper-muted);
				font-weight: 600;
			}
			.prose table tr:hover {
				background: color-mix(in srgb, var(--color-paper-muted) 70%, transparent);
			}
			.title {
				margin-bottom: var(--space-8);
				padding: var(--space-12) 0 var(--space-8);
				text-align: center;
			}
			.title h1 {
				font-size: clamp(2.25rem, 4.8vw, 3.25rem);
				margin: 0 0 var(--space-5) 0;
				line-height: var(--leading-tight);
			}
			.meta {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: var(--space-2) var(--space-4);
				margin-bottom: var(--space-3);
				color: var(--color-ink-muted);
				font-size: var(--text-small);
				line-height: var(--leading-ui);
			}
			.meta-item {
				display: inline-flex;
				align-items: center;
				gap: var(--space-1);
				font-variant-numeric: tabular-nums;
			}
			.meta-item svg {
				color: var(--accent);
			}
			.meta-item.updated {
				font-style: italic;
			}
			.meta .ai-label :global(.ai-badge) {
				padding: 0;
				background: none;
				border: none;
				border-radius: var(--radius-square);
				gap: var(--space-1);
				font-size: inherit;
				font-weight: inherit;
				color: inherit;
			}
			.iine-wrapper {
				display: flex;
				justify-content: center;
				margin: 1.5rem 0;
			}
			.iine-button {
				display: inline-flex;
				align-items: center;
				gap: var(--space-1);
				min-width: var(--touch-target);
				min-height: var(--touch-target);
				justify-content: center;
				background: transparent;
				border: 1px solid var(--border);
				border-radius: var(--radius-pill);
				padding: var(--space-2) var(--space-4);
				cursor: pointer;
				transition:
					border-color var(--duration-fast) ease,
					background-color var(--duration-fast) ease;
			}
			.iine-button:hover {
				border-color: var(--accent);
				background: var(--accent-soft);
			}
			@media (max-width: 720px) {
				.title {
					padding-top: var(--space-8);
				}
				.prose table {
					font-size: var(--text-caption);
				}
				.prose table th,
				.prose table td {
					padding: var(--space-2) var(--space-3);
				}
			}
		</style>
	</head>

	<style is:global>
		.iine-button .icon {
			color: var(--color-like);
		}
		.iine-button .icon svg {
			color: var(--color-like);
		}
	</style>

	<body data-motion-page="article">
		<SiteShell typewriter>
			<article>
				<div class="hero-image" data-motion-scene={heroImage ? 'article-hero' : undefined}>
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={heroImageAlt || ''} />}
				</div>
				<div class="prose">
					<div class="title">
						<h1 data-motion-article-title>
							<span class="sr-only">{title}</span>
							<span aria-hidden="true" data-typewriter>{title}</span>
						</h1>
						<div class="meta">
							<span class="meta-item" data-motion-meta-item>
								<Icon name="mdi:account" width={18} height={18} aria-hidden="true" />
								<span data-typewriter data-typewriter-reserve>{SITE_AUTHOR}</span>
							</span>
							<span class="meta-item ai-label" data-motion-meta-item>
								<AILabelBadge level={ai_label} />
							</span>
							<span class="meta-item" data-motion-meta-item>
								<Icon name="mdi:calendar" width={18} height={18} aria-hidden="true" />
								<FormattedDate date={time} typewriter />
							</span>
							{
								updatedDate && (
									<span class="meta-item updated" data-motion-meta-item>
										<Icon name="mdi:calendar-outline" width={18} height={18} aria-hidden="true" />
										<span data-typewriter data-typewriter-reserve>更新于</span>
										<FormattedDate date={updatedDate} typewriter />
									</span>
								)
							}
						</div>
						<div data-motion-tags>
							<TagList tags={tags} showLabel={true} typewriter />
						</div>
					</div>
					<div class="article-body" data-motion-scene="article-body">
						<slot />
					</div>
					<div class="iine-wrapper" data-motion-scene="article-feedback">
						<button
							class="iine-button"
							data-icon="heart"
							data-label="点赞"
							aria-hidden="true">
						</button>
					</div>
					<hr aria-hidden="true" />

					<div data-motion-scene="article-comments">
						<PostActions postId={postId || ''} postPath={`/blog/${postId}`} />
					</div>


				</div>
			</article>
		</SiteShell>
		<script>
			import '../scripts/page-motion';
		</script>
		<!--
			iine 只在 DOMContentLoaded 时初始化：
			defer 保证脚本在事件触发前执行完（async 可能晚于事件触发，导致按钮一直空白）；
			自托管 public/js/iine.mini.js，避免 CDN 不可达时拖慢 DOMContentLoaded。
		-->
		<script is:inline defer src="/js/iine.mini.js"></script>
	</body>
</html>

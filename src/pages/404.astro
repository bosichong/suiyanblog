---
import BaseHead from '../components/BaseHead.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`404 - 页面走丢了 | ${SITE_TITLE}`}
			description="抱歉，您访问的页面不存在"
			motionMode="reveal"
		/>
		<style>
			main {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: 0 auto;
			}
			
			.error-container {
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 60vh;
				padding: var(--space-8);
			}
			
			.error-content {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: var(--space-8);
				text-align: center;
			}
			
			.error-image {
				max-width: 100%;
				height: auto;
				border: 1px solid var(--border-soft);
				border-radius: var(--radius-square);
				background: var(--color-paper-muted);
			}
			
			.error-text p {
				color: var(--footer-text);
				margin: 0.5rem 0;
				text-align: center;
				text-indent: 0;
			}
			
			.error-text h1 {
				font-size: 2rem;
				margin: 0.5rem 0;
			}
			
.back-home {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: var(--touch-target);
				margin-top: var(--space-4);
				padding: var(--space-3) var(--space-6);
				background: var(--accent);
				color: var(--accent-text);
				border-radius: var(--radius-control);
				font-weight: 600;
				text-decoration: none;
				transition: background-color var(--duration-fast) ease;
			}
			
			.back-home:hover {
				background: var(--accent-dark);
			}
			
			@media (max-width: 480px) {
				.error-text h1 {
					font-size: 1.5rem;
				}
				
				.error-image {
					max-width: 90%;
				}
			}
		</style>
	</head>
	<body data-motion-page="static">
		<SiteShell>
			<div class="error-container">
				<div class="error-content" data-motion-scene>
					<img src="/assets/images/404.avif" alt="404" class="error-image" />
					<div class="error-text">
						<p>错误 404</p>
						<h1>页面未找到</h1>
						<p>抱歉，您访问的页面不存在。</p>
						<a href="/" class="back-home">返回首页</a>
					</div>
				</div>
			</div>
		</SiteShell>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

---
import BaseHead from '../components/BaseHead.astro';
import SiteShell from '../components/SiteShell.astro';
import PostActions from '../components/PostActions.astro';
import {
	LINKS_PAGE_TITLE,
	LINKS_PAGE_DESCRIPTION,
	LINKS,
	BLOG_AGGREGATION_TITLE,
	BLOG_AGGREGATION_DESCRIPTION,
	BLOG_AGGREGATIONS,
	SITE_DESCRIPTION,
	SITE_TITLE
} from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`链接 | ${SITE_TITLE}`}
			description={`${SITE_DESCRIPTION} - 链接和博客聚合平台`}
		/>
		<style>
			main {
				width: 720px;
			}

			section {
				margin-bottom: 3rem;
			}

			section:last-child {
				margin-bottom: 0;
			}

			hgroup {
				margin-bottom: 2rem;
				padding: 2rem;
				background: transparent;
				border: 1px solid var(--border);
				border-radius: 0;
			}

			hgroup h2 {
				font-size: 1.75rem;
				margin-bottom: 0.75rem;
				color: var(--heading-color);
			}

			hgroup p {
				color: var(--footer-text);
				font-size: 1rem;
				line-height: 1.6;
			}

			.link-list {
				list-style: none;
				padding: 0;
				margin: 0;
				border-top: 1px solid var(--border);
			}

			.link-list li {
				border-bottom: 1px solid var(--border);
			}

			.link-list a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.9rem 0.25rem;
				color: var(--heading-color);
				text-decoration: none;
				transition: color 0.2s ease, padding-left 0.2s ease;
			}

			.link-list a:hover {
				color: var(--accent);
				padding-left: 0.75rem;
			}

			.external-icon {
				flex-shrink: 0;
				color: var(--footer-text);
				opacity: 0.6;
				transition: color 0.2s ease, opacity 0.2s ease;
			}

			.link-list a:hover .external-icon {
				color: var(--accent);
				opacity: 1;
			}

			.divider {
				margin: 3rem 0;
				border: none;
				height: 1px;
				background: linear-gradient(
					to right,
					transparent,
					var(--border-color),
					transparent
				);
			}

			@media (max-width: 720px) {
				hgroup {
					padding: 1.5rem;
				}

				hgroup h2 {
					font-size: 1.5rem;
				}

				.link-list a {
					padding: 0.8rem 0.25rem;
				}
			}
		</style>
	</head>
	<body>
		<SiteShell>
			<section>
				<article>
					<hgroup>
						<h2>{LINKS_PAGE_TITLE}</h2>
						<p>{LINKS_PAGE_DESCRIPTION}</p>
					</hgroup>
					<ul class="link-list">
						{LINKS.map(link => (
							<li>
								<a href={link.site_url} target="_blank" rel="noopener noreferrer">
									<span>{link.site_name}</span>
									<svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
										<polyline points="15 3 21 3 21 9" />
										<line x1="10" y1="14" x2="21" y2="3" />
									</svg>
								</a>
							</li>
						))}
					</ul>
				</article>
			</section>

			<hr class="divider" />

			<section>
				<article>
					<hgroup>
						<h2>{BLOG_AGGREGATION_TITLE}</h2>
						<p>{BLOG_AGGREGATION_DESCRIPTION}</p>
					</hgroup>
					<ul class="link-list">
						{BLOG_AGGREGATIONS.map(link => (
							<li>
								<a href={link.site_url} target="_blank" rel="noopener noreferrer">
									<span>{link.site_name}</span>
									<svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
										<polyline points="15 3 21 3 21 9" />
										<line x1="10" y1="14" x2="21" y2="3" />
									</svg>
								</a>
							</li>
						))}
					</ul>
				</article>
			</section>

			<hr aria-hidden="true" />
			<PostActions postId="links" postPath="/links" />
		</SiteShell>
	</body>
</html>

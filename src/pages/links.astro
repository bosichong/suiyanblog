---
import BaseHead from '../components/BaseHead.astro';
import SiteShell from '../components/SiteShell.astro';
import PostActions from '../components/PostActions.astro';
import { Icon } from 'astro-icon/components';
import {
	LINKS_PAGE_TITLE,
	LINKS_PAGE_DESCRIPTION,
	LINKS,
	BLOG_AGGREGATION_TITLE,
	BLOG_AGGREGATION_DESCRIPTION,
	BLOG_AGGREGATIONS,
	SITE_DESCRIPTION,
	SITE_TITLE
} from '../consts';

---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`链接 | ${SITE_TITLE}`}
			description={`${SITE_DESCRIPTION} - 链接和博客聚合平台`}
			motionMode="full"
		/>
		<style>
			main {
				width: var(--content-width);
			}

			section {
				margin-bottom: var(--space-12);
			}

			section:last-child {
				margin-bottom: 0;
			}

			hgroup {
				margin-bottom: var(--space-8);
				padding: var(--space-8);
				background: var(--color-paper-muted);
				border: 1px solid var(--border);
				border-radius: var(--radius-square);
			}

			hgroup h2 {
				font-size: var(--text-h2);
				margin-bottom: var(--space-3);
				color: var(--heading-color);
			}

			hgroup p {
				color: var(--footer-text);
				font-size: var(--text-base);
				line-height: var(--leading-ui);
				text-align: left;
				text-indent: 0;
			}

			/* 宽屏：三列卡片式网格 */
			.link-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: var(--space-2);
			}

			.link-list li {
				display: flex;
				min-width: 0;
				border: 1px solid var(--border);
				transition:
					border-color var(--duration-fast) ease,
					background-color var(--duration-fast) ease;
			}

			.link-list li:hover,
			.link-list li:focus-within {
				border-color: var(--accent);
				background: var(--accent-soft);
			}

			.link-list a {
				display: flex;
				flex: 1 1 auto;
				align-items: center;
				justify-content: space-between;
				gap: var(--space-2);
				padding: var(--space-3) var(--space-4);
				color: var(--heading-color);
				text-decoration: none;
				transition: color var(--duration-fast) ease;
			}

			.link-list a:hover {
				color: var(--accent);
			}

			.site-name {
				display: inline-flex;
				align-items: center;
				gap: var(--space-1);
				min-width: 0;
				font-size: var(--text-small);
				line-height: var(--leading-ui);
			}

			.site-name--female {
				color: var(--color-female);
			}

			.female-icon {
				flex-shrink: 0;
			}

			.external-icon {
				flex-shrink: 0;
				color: var(--footer-text);
				opacity: 0.6;
				transition: color var(--duration-fast) ease, opacity var(--duration-fast) ease;
			}

			.link-list a:hover .external-icon {
				color: var(--accent);
				opacity: 1;
			}

			.divider {
				margin: var(--space-12) 0;
				border: none;
				height: 1px;
				background: var(--border-color);
			}

			/* 移动端 / 窄屏：恢复一行一个 */
			@media (max-width: 720px) {
				hgroup {
					padding: var(--space-6);
				}

				hgroup h2 {
					font-size: var(--text-h3);
				}

				.link-list {
					grid-template-columns: 1fr;
					gap: 0;
					border-top: 1px solid var(--border);
				}

				.link-list li {
					border: none;
					border-bottom: 1px solid var(--border);
					transition: none;
				}

				.link-list li:hover,
				.link-list li:focus-within {
					background: transparent;
				}

				.link-list a {
					flex: 1 1 auto;
					padding: var(--space-3) var(--space-1);
					transition: color var(--duration-fast) ease;
				}

				.link-list a:hover {
					color: var(--accent);
				}
			}
		</style>
	</head>
	<body data-motion-page="links">
		<SiteShell>
			<section class="link-section" data-motion-frame>
				<article>
					<hgroup class="link-section-heading">
						<h2>
							<span class="sr-only">{LINKS_PAGE_TITLE}</span>
							<span aria-hidden="true" data-typewriter>{LINKS_PAGE_TITLE}</span>
						</h2>
						<p>
							<span class="sr-only">{LINKS_PAGE_DESCRIPTION}</span>
							<span aria-hidden="true" data-typewriter>{LINKS_PAGE_DESCRIPTION}</span>
						</p>
					</hgroup>
					<ul class="link-list" data-shuffle-list>
						{LINKS.map(link => (
							<li data-motion-item>
								<a href={link.site_url} target="_blank" rel="noopener noreferrer">
									<span class="sr-only">
										{link.site_name}{link.is_female ? '（女性博主）' : ''}
									</span>
									<span
										class:list={['site-name', { 'site-name--female': link.is_female }]}
										aria-hidden="true"
									>
										<span data-typewriter>{link.site_name}</span>
										{link.is_female && (
											<Icon
												name="mdi:gender-female"
												class="female-icon"
												width={16}
												height={16}
												aria-hidden="true"
											/>
										)}
									</span>
									<svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
										<polyline points="15 3 21 3 21 9" />
										<line x1="10" y1="14" x2="21" y2="3" />
									</svg>
								</a>
							</li>
						))}
					</ul>
				</article>
			</section>

			<hr class="divider" data-motion-divider aria-hidden="true" />

			<section class="link-section" data-motion-frame>
				<article>
					<hgroup class="link-section-heading">
						<h2>
							<span class="sr-only">{BLOG_AGGREGATION_TITLE}</span>
							<span aria-hidden="true" data-typewriter>{BLOG_AGGREGATION_TITLE}</span>
						</h2>
						<p>
							<span class="sr-only">{BLOG_AGGREGATION_DESCRIPTION}</span>
							<span aria-hidden="true" data-typewriter>{BLOG_AGGREGATION_DESCRIPTION}</span>
						</p>
					</hgroup>
					<ul class="link-list" data-shuffle-list>
						{BLOG_AGGREGATIONS.map(link => (
							<li data-motion-item>
								<a href={link.site_url} target="_blank" rel="noopener noreferrer">
									<span class="sr-only">{link.site_name}</span>
									<span class="site-name" aria-hidden="true">
										<span data-typewriter>{link.site_name}</span>
									</span>
									<svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
										<polyline points="15 3 21 3 21 9" />
										<line x1="10" y1="14" x2="21" y2="3" />
									</svg>
								</a>
							</li>
						))}
					</ul>
				</article>
			</section>

			<hr aria-hidden="true" />
			<PostActions postId="links" postPath="/links" />
		</SiteShell>
		<script is:inline>
			(() => {
				const shuffleLists = () => {
					document.querySelectorAll('[data-shuffle-list]').forEach((list) => {
						const items = Array.from(list.children);
						for (let i = items.length - 1; i > 0; i--) {
							const j = Math.floor(Math.random() * (i + 1));
							[items[i], items[j]] = [items[j], items[i]];
						}
						list.replaceChildren(...items);
					});
				};

				shuffleLists();
				window.addEventListener('pageshow', (event) => {
					if (event.persisted) shuffleLists();
				});
			})();
		</script>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

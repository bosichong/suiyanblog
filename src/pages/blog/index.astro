---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SiteShell from '../../components/SiteShell.astro';
import TagList from '../../components/TagList.astro';
import { Icon } from 'astro-icon/components';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_AUTHOR } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.time).valueOf() - new Date(a.data.time).valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`Blog - ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			motionMode="reveal"
		/>
		<style>
			main {
				width: var(--content-width);
			}
			.blog-header {
				text-align: center;
				margin-bottom: var(--space-12);
			}
			.blog-header h1 {
				margin-bottom: var(--space-2);
				font-size: var(--text-h1);
			}
			.blog-header .subtitle {
				color: var(--footer-text);
				font-size: var(--text-base);
				line-height: var(--leading-ui);
				margin: 0;
				text-align: center;
				text-indent: 0;
			}
			.tags-link {
				display: inline-block;
				margin-top: var(--space-4);
				color: var(--accent);
				text-decoration-color: transparent;
				font-size: var(--text-small);
				font-weight: 500;
				letter-spacing: var(--tracking-label);
				transition:
					color var(--duration-fast) ease,
					text-decoration-color var(--duration-fast) ease;
			}
			.tags-link:hover {
				color: var(--accent-dark);
				text-decoration-color: currentColor;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: var(--space-8);
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: 100%;
				background: var(--color-paper-muted);
				border: 1px solid var(--border);
				border-radius: var(--radius-square);
				overflow: hidden;
				transition: border-color var(--duration-fast) ease;
			}
			ul li:hover {
				border-color: var(--accent);
			}
			ul li * {
				text-decoration: none;
			}
			ul li img {
				margin-bottom: 0;
				border-radius: var(--radius-square);
				width: 100%;
				height: auto;
				display: block;
			}
			.card-image-link {
				display: block;
				color: inherit;
			}
			.card-text-link {
				display: block;
				color: inherit;
			}
			.card-text-link:hover .title {
				color: var(--accent-dark);
			}
			.card-text-link:hover .description {
				opacity: 1;
			}
			.post-content {
				padding: var(--space-8);
			}
			.post-meta {
				display: flex;
				align-items: center;
				gap: var(--space-5);
				margin-bottom: var(--space-3);
				font-size: var(--text-small);
				line-height: var(--leading-ui);
				color: var(--footer-text);
				font-weight: 500;
			}
			.meta-item {
				display: flex;
				align-items: center;
				gap: var(--space-2);
				font-variant-numeric: tabular-nums;
			}
			.meta-item svg {
				color: var(--accent);
				flex-shrink: 0;
			}
			.title {
				margin: 0;
				color: var(--heading-color);
				line-height: var(--leading-heading);
				font-size: var(--text-h2);
				font-weight: 600;
				margin-bottom: var(--space-3);
			}
			.description {
				margin: 0;
				color: var(--text-color);
				line-height: var(--leading-ui);
				font-size: 1.0625rem;
				opacity: 0.9;
			}
			.post-content hr {
				height: 1px;
				margin: var(--space-5) 0;
				background: var(--border-soft);
			}
			.post-content hr::before {
				display: none;
			}
			
			@media (max-width: 720px) {
				.blog-header h1 {
					font-size: 2rem;
				}
				.blog-header .subtitle {
					font-size: 1rem;
				}
				ul {
					gap: var(--space-6);
				}
				.post-content {
					padding: var(--space-6);
				}
				.title {
					font-size: var(--text-h3);
					margin-bottom: var(--space-2);
				}
				.description {
					font-size: var(--text-base);
				}
				.post-meta {
					font-size: var(--text-caption);
					margin-bottom: var(--space-3);
					gap: var(--space-4);
				}
				.meta-item {
					gap: var(--space-2);
				}
				
				/* Custom styling for tags in blog index */
				.post-content :global(.tag-list) {
					justify-content: flex-start;
					margin: 0 !important;
				}
				
				.post-content :global(.tag-link) {
					padding: 0.125rem 0.5rem !important;
				}
				
				.post-content :global(.tag-more) {
					padding: 0.125rem 0.5rem !important;
				}
			}
		</style>
	</head>
	<body data-motion-page="static">
		<SiteShell>
			<section>
				<div class="blog-header" data-motion-scene>
					<h1>Blog</h1>
					<p class="subtitle">Learnings, thoughts, and more.</p>
					<a href="/tags" class="tags-link">Browse all tags →</a>
				</div>
				<ul data-motion-scene>
					{
						   posts.map((post, idx) => (
							   <li>
								   {post.data.heroImage && (
									   <a href={`/blog/${post.id}`} class="card-image-link" aria-label={post.data.title}>
										   <Image 
											   width={720} 
											   height={360} 
											   src={post.data.heroImage} 
											   alt={post.data.heroImageAlt || ''} 
											   loading={idx < 2 ? 'eager' : 'lazy'}
										   />
									   </a>
								   )}
								   <div class="post-content">
									   <a href={`/blog/${post.id}`} class="card-text-link">
										<div class="post-meta">
											<div class="meta-item">
												<Icon name="mdi:calendar" width={16} height={16} aria-hidden="true" />
												<FormattedDate date={post.data.time} />
											</div>
											<div class="meta-item">
												<Icon name="mdi:account" width={16} height={16} aria-hidden="true" />
												<span class="author">{SITE_AUTHOR}</span>
											</div>
										</div>
									<hr aria-hidden="true" />
									<h2 class="title">{post.data.title}</h2>
										{post.data.description && (
											<p class="description">{post.data.description}</p>
										)}
									   </a>
									   <hr aria-hidden="true" />
									   <TagList tags={post.data.tags} limit={5} />
								   </div>
							   </li>
						   ))
					   }
				   </ul>
			</section>
		</SiteShell>
		<script>
			import '../../scripts/page-motion';
		</script>
	</body>
</html>

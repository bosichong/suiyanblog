---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_AUTHOR, SITE_TITLE, HOME_POSTS_COUNT } from '../consts';
import { formatDateShort } from '../utils/date';

// 获取所有博客文章，按时间排序，取最新 N 篇
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => new Date(b.data.time).valueOf() - new Date(a.data.time).valueOf())
	.slice(0, HOME_POSTS_COUNT);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`首页 | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			motionMode="full"
		/>
		<style>
			main {
				width: var(--content-width);
			}

			.hero {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: 0 auto var(--space-12);
				padding-top: var(--space-8);
				display: flex;
				align-items: center;
				gap: var(--space-5);
			}
			.hero-avatar {
				width: 4rem;
				height: 4rem;
				border-radius: var(--radius-pill);
				object-fit: cover;
				flex-shrink: 0;
			}
			.hero-text {
				flex: 1;
			}
			.hero-title {
				font-size: var(--text-h3);
				font-weight: 600;
				line-height: var(--leading-heading);
				margin: 0;
				color: var(--text);
				text-align: left;
				text-indent: 0;
			}
			.hero-desc {
				font-size: var(--text-small);
				line-height: var(--leading-ui);
				margin: var(--space-1) 0 0;
				color: var(--text-muted);
				text-align: left;
				text-indent: 0;
			}
			@media (min-width: 721px) {
				.hero {
					margin-bottom: var(--space-16);
				}
				.hero-avatar {
					width: 5rem;
					height: 5rem;
				}
				.hero-title {
					font-size: 1.75rem;
				}
			}

			.category-section {
				margin-bottom: var(--space-12);
			}

			.view-more {
				display: block;
				margin-top: var(--space-6);
				text-align: center;
				color: var(--accent);
				text-decoration-color: transparent;
				font-size: var(--text-small);
				letter-spacing: var(--tracking-label);
				transition:
					color var(--duration-fast) ease,
					text-decoration-color var(--duration-fast) ease;
			}

			.view-more:hover {
				color: var(--accent-dark);
				text-decoration-color: currentColor;
			}

			.post-item {
				display: flex;
				align-items: center;
				gap: var(--space-3);
				text-decoration: none;
				color: var(--text-color);
				padding: var(--space-3) 0;
				transition: color var(--duration-fast) ease;
			}
			.post-item:hover {
				color: var(--accent);
			}
			.post-line {
				flex: 1;
				min-width: var(--space-5);
				height: 1px;
				background: var(--border-color);
				transition: background-color var(--duration-fast) ease;
			}
			.post-item:hover .post-line {
				background: var(--accent);
			}
			.post-title {
				font-size: 1.125rem;
				line-height: var(--leading-ui);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				flex-shrink: 1;
				min-width: 0;
			}
			.post-date {
				color: var(--text-muted);
				font-size: var(--text-small);
				font-weight: 500;
				font-variant-numeric: tabular-nums;
				letter-spacing: var(--tracking-label);
				white-space: nowrap;
				flex-shrink: 0;
				transition: color var(--duration-fast) ease;
			}
			.post-item:hover .post-date {
				color: var(--accent);
			}

			@media (max-width: 720px) {
				.post-title {
					font-size: var(--text-base);
					line-height: 1.5;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}
				.post-date {
					font-size: var(--text-caption);
				}
			}

		</style>
	</head>
	<body data-motion-page="home">
		<SiteShell>
			<header class="hero" data-motion-frame>
				<a href="/" data-motion-avatar>
					<img src="/assets/images/avatar.jpg" alt={SITE_AUTHOR} class="hero-avatar" loading="eager" fetchpriority="high" decoding="async" width="80" height="80" />
				</a>
				<div class="hero-text" data-motion-content>
					<p class="hero-title">{SITE_TITLE}</p>
					<p class="hero-desc">
						<span class="sr-only">{SITE_DESCRIPTION}</span>
						<span aria-hidden="true" data-typewriter>{SITE_DESCRIPTION}</span>
					</p>
				</div>
			</header>
			<section class="category-section" data-motion-frame>
				{recentPosts.map((post) => (
					<a href={`/blog/${post.id}`} class="post-item" data-motion-item>
						<span class="post-title">
							<span class="sr-only">
								{post.data.title}，{formatDateShort(post.data.time)}
							</span>
							<span aria-hidden="true" data-typewriter>{post.data.title}</span>
						</span>
						<div class="post-line" aria-hidden="true"></div>
						<time class="post-date" datetime={post.data.time} aria-hidden="true">
							{formatDateShort(post.data.time)}
						</time>
					</a>
				))}
				<a href="/archive" class="view-more" data-motion-item>「更多文章」</a>
			</section>
		</SiteShell>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

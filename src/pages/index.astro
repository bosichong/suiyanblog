---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_AUTHOR, SITE_TITLE, HOME_POSTS_COUNT } from '../consts';
import { formatDateShort } from '../utils/date';

// 获取所有博客文章，按时间排序，取最新 N 篇
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => new Date(b.data.time).valueOf() - new Date(a.data.time).valueOf())
	.slice(0, HOME_POSTS_COUNT);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`首页 | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			motionMode="full"
		/>
		<style>
			main {
				width: var(--content-width);
			}

			.hero {
				width: var(--content-width);
				max-width: calc(100% - 2em);
				margin: 0 auto var(--space-12);
				padding-top: var(--space-8);
				display: flex;
				align-items: center;
				gap: var(--space-5);
			}
			.hero-avatar {
				width: 4rem;
				height: 4rem;
				border-radius: var(--radius-pill);
				object-fit: cover;
				flex-shrink: 0;
			}
			.hero-avatar-link {
				position: relative;
				display: block;
				flex-shrink: 0;
				border-radius: var(--radius-pill);
				overflow: hidden;
				line-height: 0;
				isolation: isolate;
			}
			.hero-avatar-link::before,
			.hero-avatar-link::after {
				content: "";
				position: absolute;
				inset: 0;
				z-index: 1;
				opacity: 0;
				pointer-events: none;
			}
			.hero-avatar-link::before {
				background:
					linear-gradient(
						180deg,
						transparent 24%,
						color-mix(in srgb, var(--glitch-red) 42%, transparent) 24% 30%,
						transparent 30% 62%,
						color-mix(in srgb, var(--glitch-cyan) 38%, transparent) 62% 67%,
						transparent 67%
					);
			}
			.hero-avatar-link::after {
				top: 48%;
				bottom: auto;
				height: 1px;
				background: linear-gradient(
					90deg,
					transparent,
					var(--glitch-cyan),
					var(--color-paper),
					var(--glitch-red),
					transparent
				);
			}
			.hero-avatar-link.is-avatar-glitching img {
				animation: suiyan-avatar-image-glitch 260ms steps(3, end);
			}
			.hero-avatar-link.is-avatar-glitching::before {
				animation: suiyan-avatar-strips 260ms steps(3, end);
			}
			.hero-avatar-link.is-avatar-glitching::after {
				animation: suiyan-avatar-scan 260ms ease-out;
			}
			.hero-text {
				flex: 1;
			}
			.hero-title {
				font-size: var(--text-h3);
				font-weight: 600;
				line-height: var(--leading-heading);
				margin: 0;
				color: var(--text);
				text-align: left;
				text-indent: 0;
			}
			.hero-desc {
				font-size: var(--text-small);
				line-height: var(--leading-ui);
				margin: var(--space-1) 0 0;
				color: var(--text-muted);
				text-align: left;
				text-indent: 0;
			}
			@media (min-width: 721px) {
				.hero {
					margin-bottom: var(--space-16);
				}
				.hero-avatar {
					width: 5rem;
					height: 5rem;
				}
				.hero-title {
					font-size: 1.75rem;
				}
			}

			.category-section {
				margin-bottom: var(--space-12);
			}

			.view-more {
				display: block;
				margin-top: var(--space-6);
				text-align: center;
				color: var(--accent);
				text-decoration-color: transparent;
				font-size: var(--text-small);
				letter-spacing: var(--tracking-label);
				transition:
					color var(--duration-fast) ease,
					text-decoration-color var(--duration-fast) ease;
			}

			.view-more:hover {
				color: var(--accent-dark);
				text-decoration-color: currentColor;
			}

			.post-item {
				display: flex;
				align-items: center;
				gap: var(--space-3);
				text-decoration: none;
				color: var(--text-color);
				padding: var(--space-3) 0;
				transition: color var(--duration-fast) ease;
			}
			.post-item:hover {
				color: var(--accent);
			}
			.post-line {
				position: relative;
				flex: 1;
				min-width: var(--space-5);
				height: 1px;
				background: var(--border-color);
				transition: background-color var(--duration-fast) ease;
				overflow: hidden;
			}
			.post-item:hover .post-line {
				background: var(--accent);
			}
			.post-line::after {
				content: "";
				position: absolute;
				inset: 0;
				background: linear-gradient(
					90deg,
					transparent,
					var(--color-paper) 46%,
					var(--glitch-cyan) 50%,
					var(--color-paper) 54%,
					transparent
				);
				opacity: 0;
				transform: translate3d(-105%, 0, 0);
				pointer-events: none;
			}
			.post-title {
				font-size: 1.125rem;
				line-height: var(--leading-ui);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				flex-shrink: 1;
				min-width: 0;
			}
			.post-date {
				color: var(--text-muted);
				font-size: var(--text-small);
				font-weight: 500;
				font-variant-numeric: tabular-nums;
				letter-spacing: var(--tracking-label);
				white-space: nowrap;
				flex-shrink: 0;
				transition: color var(--duration-fast) ease;
			}
			.post-item:hover .post-date {
				color: var(--accent);
			}

			@media (max-width: 720px) {
				.post-title {
					font-size: var(--text-base);
					line-height: 1.5;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}
				.post-date {
					font-size: var(--text-caption);
				}
			}

			@media (hover: hover) and (prefers-reduced-motion: no-preference) {
				.post-item:hover .post-line::after {
					animation: suiyan-home-line-scan 260ms ease-out both;
				}
			}

			@keyframes suiyan-home-line-scan {
				0% {
					opacity: 0;
					transform: translate3d(-105%, 0, 0);
				}
				18% {
					opacity: 0.9;
				}
				100% {
					opacity: 0;
					transform: translate3d(105%, 0, 0);
				}
			}

			@keyframes suiyan-avatar-image-glitch {
				0%,
				100% {
					transform: translate3d(0, 0, 0);
					filter: none;
					clip-path: inset(0 0 0 0 round 50%);
				}
				24% {
					transform: translate3d(-1px, 0, 0);
					filter: contrast(1.12) saturate(0.76);
					clip-path: inset(22% 0 58% 0 round 50%);
				}
				58% {
					transform: translate3d(1px, 0, 0);
					filter: contrast(1.16) saturate(0.66);
					clip-path: inset(0 0 0 0 round 50%);
				}
			}

			@keyframes suiyan-avatar-strips {
				0%,
				100% {
					opacity: 0;
					transform: translate3d(0, 0, 0);
				}
				28% {
					opacity: 0.82;
					transform: translate3d(-2px, 0, 0);
				}
				62% {
					opacity: 0.58;
					transform: translate3d(2px, 0, 0);
				}
			}

			@keyframes suiyan-avatar-scan {
				0% {
					opacity: 0;
					transform: translate3d(-110%, 0, 0);
				}
				28% {
					opacity: 0.9;
				}
				100% {
					opacity: 0;
					transform: translate3d(110%, 0, 0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.post-line::after {
					display: none;
				}
				.hero-avatar-link::before,
				.hero-avatar-link::after {
					display: none;
				}
				.hero-avatar-link img {
					animation: none;
				}
			}

		</style>
	</head>
	<body data-motion-page="home">
		<SiteShell>
			<header class="hero" data-motion-frame>
				<a
					href="/"
					class="hero-avatar-link"
					data-motion-avatar
					data-glitch-visual="avatar"
					data-glitch-on="idle"
					data-glitch-group="avatar"
					data-glitch-introduce
				>
					<img src="/assets/images/avatar.jpg" alt={SITE_AUTHOR} class="hero-avatar" loading="eager" fetchpriority="high" decoding="async" width="80" height="80" />
				</a>
				<div class="hero-text" data-motion-content>
					<p class="hero-title">
						<span class="sr-only">{SITE_TITLE}</span>
						<span
							aria-hidden="true"
							data-glitch-text="rgb"
							data-glitch-on="mount"
							data-glitch-after="ambient"
							data-glitch-showcase="brand"
							data-glitch-chance="0.7"
						>{SITE_TITLE}</span>
					</p>
					<p class="hero-desc">
						<span class="sr-only">{SITE_DESCRIPTION}</span>
						<span
							aria-hidden="true"
							data-typewriter
							data-glitch-text="rgb"
							data-glitch-on="idle"
							data-glitch-group="intro"
							data-glitch-introduce
							data-glitch-idle-chance="0.78"
						>{SITE_DESCRIPTION}</span>
					</p>
				</div>
			</header>
			<section class="category-section" data-motion-frame>
				{recentPosts.map((post) => (
					<a href={`/blog/${post.id}`} class="post-item" data-motion-item>
						<span class="post-title">
							<span class="sr-only">
								{post.data.title}，{formatDateShort(post.data.time)}
							</span>
							<span
								aria-hidden="true"
								data-typewriter
								data-glitch-text="micro"
								data-glitch-on="idle hover"
								data-glitch-group="title"
								data-glitch-introduce
								data-glitch-idle-chance="0.78"
								data-glitch-hover-chance="0.32"
								data-glitch-cooldown="1800"
							>{post.data.title}</span>
						</span>
						<div class="post-line" aria-hidden="true"></div>
						<time class="post-date" datetime={post.data.time} aria-hidden="true">
							{formatDateShort(post.data.time)}
						</time>
					</a>
				))}
				<a href="/archive" class="view-more" data-motion-item>「更多文章」</a>
			</section>
		</SiteShell>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

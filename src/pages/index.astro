---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_AUTHOR, SITE_TITLE, HOME_POSTS_COUNT } from '../consts';
import { formatDateShort } from '../utils/date';

// 获取所有博客文章，按时间排序，取最新 N 篇
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => new Date(b.data.time).valueOf() - new Date(a.data.time).valueOf())
	.slice(0, HOME_POSTS_COUNT);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`首页 | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			motionMode="full"
		/>
		<style>
			main {
				width: 720px;
			}

			.hero {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto 3rem;
				padding-top: 2rem;
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.hero-avatar {
				width: 4rem;
				height: 4rem;
				border-radius: 50%;
				object-fit: cover;
				flex-shrink: 0;
			}
			.hero-text {
				flex: 1;
			}
			.hero-title {
				font-size: 1.5rem;
				font-weight: 500;
				line-height: 1.25;
				margin: 0;
				color: var(--text);
				text-align: left;
				text-indent: 0;
			}
			.hero-desc {
				font-size: 0.875rem;
				line-height: 1.25;
				margin: 0.25rem 0 0;
				color: var(--text-soft);
				text-align: left;
				text-indent: 0;
			}
			@media (min-width: 721px) {
				.hero {
					margin-bottom: 4rem;
				}
				.hero-avatar {
					width: 5rem;
					height: 5rem;
				}
				.hero-title {
					font-size: 1.875rem;
				}
			}

			.category-section {
				margin-bottom: 3rem;
			}

			.view-more {
				display: block;
				margin-top: 1rem;
				text-align: center;
				color: var(--accent);
				text-decoration: none;
				font-size: 0.95rem;
				transition: color 0.2s ease;
			}

			.view-more:hover {
				color: var(--accent-dark);
			}

			.post-item {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				text-decoration: none;
				color: var(--text-color);
				padding: 0.6rem 0;
				transition: color 0.2s ease, padding-left 0.2s ease;
			}
			.post-item:hover {
				color: var(--accent);
				padding-left: 0.75rem;
			}
			.post-line {
				flex: 1;
				height: 1px;
				background: var(--border-color);
			}
			.post-title {
				font-size: 1.125rem;
				line-height: 1.5;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				flex-shrink: 1;
				min-width: 0;
			}
			.post-date {
				color: var(--text-muted);
				font-size: 0.9rem;
				font-weight: 500;
				white-space: nowrap;
				flex-shrink: 0;
				transition: color 0.2s ease;
			}
			.post-item:hover .post-date {
				color: var(--accent);
			}

			@media (max-width: 720px) {
				.post-title {
					font-size: 1rem;
				}
				.post-date {
					font-size: 0.85rem;
				}
			}

		</style>
	</head>
	<body data-motion-page="home">
		<SiteShell>
			<header class="hero" data-motion-frame>
				<a href="/" data-motion-avatar>
					<img src="/assets/images/avatar.jpg" alt={SITE_AUTHOR} class="hero-avatar" loading="eager" fetchpriority="high" decoding="async" width="80" height="80" />
				</a>
				<div class="hero-text" data-motion-content>
					<p class="hero-title">{SITE_TITLE}</p>
					<p class="hero-desc">
						<span class="sr-only">{SITE_DESCRIPTION}</span>
						<span aria-hidden="true" data-typewriter>{SITE_DESCRIPTION}</span>
					</p>
				</div>
			</header>
			<section class="category-section" data-motion-frame>
				{recentPosts.map((post) => (
					<a href={`/blog/${post.id}`} class="post-item" data-motion-item>
						<span class="post-title">
							<span class="sr-only">
								{post.data.title}，{formatDateShort(post.data.time)}
							</span>
							<span aria-hidden="true" data-typewriter>{post.data.title}</span>
						</span>
						<div class="post-line" aria-hidden="true"></div>
						<time class="post-date" datetime={post.data.time} aria-hidden="true">
							{formatDateShort(post.data.time)}
						</time>
					</a>
				))}
				<a href="/archive" class="view-more" data-motion-item>「更多文章」</a>
			</section>
		</SiteShell>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

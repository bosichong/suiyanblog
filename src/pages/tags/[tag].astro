---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SiteShell from '../../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { slugify } from '../../utils/slugify';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const tagsBySlug = new Map<
		string,
		{ labelCounts: Map<string, number>; posts: typeof allPosts }
	>();

	allPosts.forEach((post) => {
		post.data.tags.forEach((tag) => {
			const tagSlug = slugify(tag);
			const group = tagsBySlug.get(tagSlug) ?? {
				labelCounts: new Map<string, number>(),
				posts: [] as typeof allPosts,
			};
			group.labelCounts.set(tag, (group.labelCounts.get(tag) ?? 0) + 1);
			group.posts.push(post);
			tagsBySlug.set(tagSlug, group);
		});
	});

	return Array.from(tagsBySlug.entries()).map(([tagSlug, group]) => {
		const tagName =
			Array.from(group.labelCounts.entries()).sort(
				([labelA, countA], [labelB, countB]) =>
					countB - countA || labelA.localeCompare(labelB),
			)[0]?.[0] ?? tagSlug;
		const posts = Array.from(
			new Map(group.posts.map((post) => [post.id, post])).values(),
		).sort(
			(a, b) => new Date(b.data.time).valueOf() - new Date(a.data.time).valueOf(),
		);

		return {
			params: { tag: tagSlug },
			props: { posts, tagName },
		};
	});
}

const { tag } = Astro.params;
const { posts, tagName } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`标签：${tagName} - ${SITE_TITLE}`}
			description={`所有带有"${tagName}"标签的文章`}
			motionMode="reveal"
		/>
		<style>
			main {
				width: var(--content-width);
			}
			.tag-header {
				text-align: center;
				margin-bottom: var(--space-12);
			}
			.tag-header h1 {
				margin-bottom: var(--space-2);
				font-size: var(--text-h1);
			}
			.tag-header .subtitle {
				color: var(--footer-text);
				font-size: var(--text-base);
				line-height: var(--leading-ui);
				margin: 0;
				text-align: center;
				text-indent: 0;
			}
			.tag-badge {
				display: inline-block;
				padding: var(--space-2) var(--space-5);
				background: var(--accent-soft);
				color: var(--accent-dark);
				border: 1px solid var(--border);
				border-radius: var(--radius-pill);
				font-size: var(--text-lead);
				font-weight: 600;
				margin: var(--space-4) 0;
			}

			.post-item {
				display: flex;
				align-items: center;
				gap: var(--space-3);
				padding: var(--space-3) 0;
				text-decoration: none;
				color: var(--text-color);
			}
			.post-line {
				flex: 1;
				min-width: var(--space-5);
				height: 1px;
				background: var(--border-color);
				transition: background-color var(--duration-fast) ease;
			}
			.post-item:hover .post-line {
				background: var(--accent);
			}
			.post-title {
				font-size: 1.125rem;
				line-height: var(--leading-ui);
				overflow: visible;
				text-overflow: clip;
				white-space: normal;
				flex-shrink: 1;
				min-width: 0;
			}
			.post-date {
				color: var(--text-muted);
				font-size: var(--text-small);
				font-weight: 500;
				font-variant-numeric: tabular-nums;
				letter-spacing: var(--tracking-label);
				white-space: nowrap;
				flex-shrink: 0;
				transition: color var(--duration-fast) ease;
			}
			.post-item:hover .post-date {
				color: var(--accent);
			}
			.posts-separator {
				border: none;
				border-top: 1px solid var(--border-color);
				margin: 0;
			}

			@media (max-width: 720px) {
				.tag-header h1 {
					font-size: 2rem;
				}
				.tag-header .subtitle {
					font-size: 1rem;
				}
				.tag-badge {
					font-size: var(--text-base);
					padding: var(--space-1) var(--space-4);
				}
				.post-title {
					font-size: var(--text-base);
					line-height: 1.5;
					overflow: visible;
					text-overflow: clip;
					white-space: normal;
				}
				.post-date {
					font-size: var(--text-caption);
				}
			}
		</style>
	</head>
	<body data-motion-page="static">
		<SiteShell>
			<section>
				<div class="tag-header" data-motion-scene>
					<h1>标签</h1>
					<div class="tag-badge">{tagName}</div>
					<p class="subtitle">找到 {posts.length} 篇文章</p>
				</div>
				<div class="post-list" data-motion-scene>
					{
					   posts.map((post) => (
						   <a href={`/blog/${post.id}`} class="post-item" >
							   <span class="post-title">{post.data.title}</span>
							   <div class="post-line"></div>
							   <time class="post-date"><FormattedDate date={post.data.time} /></time>
						   </a>
					   ))
				   }
				   </div>
			</section>
		</SiteShell>
		<script>
			import '../../scripts/page-motion';
		</script>
	</body>
</html>

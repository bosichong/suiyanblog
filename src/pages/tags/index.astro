---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import SiteShell from '../../components/SiteShell.astro';
import { Icon } from 'astro-icon/components';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { slugify } from '../../utils/slugify';

const allPosts = await getCollection('blog');

// Count posts for each tag
const tagCounts = allPosts.reduce((acc, post) => {
	post.data.tags.forEach((tag) => {
		acc[tag] = (acc[tag] || 0) + 1;
	});
	return acc;
}, {} as Record<string, number>);

// Sort tags by post count (descending) then alphabetically
const sortedTags = Object.entries(tagCounts)
	.sort(([a, countA], [b, countB]) => {
		const numA = countA as number;
		const numB = countB as number;
		if (numB !== numA) return numB - numA;
		return a.localeCompare(b);
	});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`所有标签 - ${SITE_TITLE}`}
			description="浏览所有博客标签"
			motionMode="reveal"
		/>
		<style>
			main {
				width: 720px;
			}
			.tags-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			.tags-header h1 {
				margin-bottom: 0.5rem;
				font-size: 3rem;
			}
			.tags-header .subtitle {
				color: var(--footer-text);
				font-size: 1.2rem;
				margin: 0;
			}
			.tags-flow {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 2rem;
			}
			.tag-item {
				display: inline-block;
				background: transparent;
				border: 1px solid var(--border);
				border-radius: 9999px;
				padding: 0.25rem 0.75rem;
				font-size: 0.875rem;
				font-weight: 500;
				color: var(--text-soft);
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.tag-item:hover {
				border-color: var(--text);
				color: var(--text);
			}
			.tag-item:focus {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}
			@media (max-width: 720px) {
				.tags-header h1 {
					font-size: 2rem;
				}
				.tags-header .subtitle {
					font-size: 1rem;
				}
				.tags-flow {
					gap: 0.375rem;
				}
				.tag-item {
					padding: 0.2rem 0.6rem;
					font-size: 0.8rem;
				}
			}
		</style>
	</head>
	<body data-motion-page="tags">
		<SiteShell>
			<section>
				<div class="tags-header" data-motion-scene>
					<h1>所有标签</h1>
					<p class="subtitle">共有 {sortedTags.length} 个标签</p>
				</div>
				<div class="tags-flow">
					{
						sortedTags.map(([tag, count]) => (
							<a href={`/tags/${slugify(tag)}`} class="tag-item" data-motion-tag>
								<span class="sr-only">{tag}（{count} 篇文章）</span>
								<span aria-hidden="true" data-typewriter data-typewriter-reserve>{tag}({count})</span>
							</a>
						))
					}
				</div>
			</section>
		</SiteShell>
		<script>
			import '../../scripts/page-motion';
		</script>
	</body>
</html>

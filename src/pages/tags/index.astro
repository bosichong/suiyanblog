---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import SiteShell from '../../components/SiteShell.astro';
import { Icon } from 'astro-icon/components';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { slugify } from '../../utils/slugify';

const allPosts = await getCollection('blog');

// Count posts for each tag
const tagsBySlug = new Map<
	string,
	{ count: number; labelCounts: Map<string, number> }
>();

allPosts.forEach((post) => {
	post.data.tags.forEach((tag) => {
		const tagSlug = slugify(tag);
		const group = tagsBySlug.get(tagSlug) ?? {
			count: 0,
			labelCounts: new Map<string, number>(),
		};
		group.count += 1;
		group.labelCounts.set(tag, (group.labelCounts.get(tag) ?? 0) + 1);
		tagsBySlug.set(tagSlug, group);
	});
});

// Sort tags by post count (descending) then alphabetically
const sortedTags = Array.from(tagsBySlug.entries())
	.map(([tagSlug, group]) => {
		const tag =
			Array.from(group.labelCounts.entries()).sort(
				([labelA, countA], [labelB, countB]) =>
					countB - countA || labelA.localeCompare(labelB),
			)[0]?.[0] ?? tagSlug;
		return { tag, tagSlug, count: group.count };
	})
	.sort((a, b) => {
		if (b.count !== a.count) return b.count - a.count;
		return a.tag.localeCompare(b.tag);
	});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`所有标签 - ${SITE_TITLE}`}
			description="浏览所有博客标签"
			motionMode="reveal"
		/>
		<style>
			main {
				width: var(--content-width);
			}
			.tags-header {
				text-align: center;
				margin-bottom: var(--space-12);
			}
			.tags-header h1 {
				margin-bottom: var(--space-2);
				font-size: var(--text-h1);
			}
			.tags-header .subtitle {
				color: var(--footer-text);
				font-size: var(--text-base);
				line-height: var(--leading-ui);
				margin: 0;
				text-align: center;
				text-indent: 0;
			}
			.tags-flow {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-2);
				margin-top: var(--space-8);
			}
			.tag-item {
				display: inline-block;
				background: transparent;
				border: 1px solid var(--border);
				border-radius: var(--radius-pill);
				padding: var(--space-1) var(--space-3);
				font-size: var(--text-small);
				font-weight: 500;
				color: var(--text-soft);
				text-decoration-color: transparent;
				transition:
					color var(--duration-fast) ease,
					border-color var(--duration-fast) ease,
					background-color var(--duration-fast) ease;
			}
			.tag-item:hover {
				border-color: var(--accent);
				background: var(--accent-soft);
				color: var(--accent-dark);
			}
			.tag-item:focus-visible {
				outline: var(--focus-ring);
				outline-offset: 2px;
			}
			@media (max-width: 720px) {
				.tags-header h1 {
					font-size: 2rem;
				}
				.tags-header .subtitle {
					font-size: 1rem;
				}
				.tags-flow {
					gap: var(--space-1);
				}
				.tag-item {
					padding: 0.1875rem 0.625rem;
					font-size: var(--text-caption);
				}
			}
		</style>
	</head>
	<body data-motion-page="tags">
		<SiteShell>
			<section>
				<div class="tags-header" data-motion-scene>
					<h1>所有标签</h1>
					<p class="subtitle">共有 {sortedTags.length} 个标签</p>
				</div>
				<div class="tags-flow">
					{
						sortedTags.map(({ tag, tagSlug, count }) => (
							<a href={`/tags/${tagSlug}`} class="tag-item" data-motion-tag>
								<span class="sr-only">{tag}（{count} 篇文章）</span>
								<span aria-hidden="true" data-typewriter data-typewriter-reserve>{tag}({count})</span>
							</a>
						))
					}
				</div>
			</section>
		</SiteShell>
		<script>
			import '../../scripts/page-motion';
		</script>
	</body>
</html>

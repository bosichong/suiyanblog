---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { formatDateMedium } from '../utils/date';

// 获取所有博客文章
const allPosts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.time).valueOf() - new Date(a.data.time).valueOf(),
);

// 提取最小化的文章信息
const minimalPosts = allPosts.map(post => ({
	id: post.id,
	title: post.data.title,
	time: post.data.time,
}));

// 按年月分组文章
const postsByMonth: { [key: string]: typeof minimalPosts } = {};
minimalPosts.forEach((post) => {
	const date = new Date(post.time);
	const year = date.getFullYear();
	const month = String(date.getMonth() + 1).padStart(2, '0');
	const key = `${year}/${month}`;
	if (!postsByMonth[key]) {
		postsByMonth[key] = [];
	}
	postsByMonth[key].push(post);
});

// 按年月降序排序
const sortedMonths = Object.keys(postsByMonth).sort((a, b) => b.localeCompare(a));

const totalPosts = allPosts.length;
const lastUpdated = allPosts[0]?.data.time ? new Date(allPosts[0].data.time) : new Date();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead 
			title={`文章归档 | ${SITE_TITLE}`} 
			description={`${SITE_DESCRIPTION} - 所有文章归档，按时间顺序整理的全部技术文章和随笔`}
			motionMode="reveal"
		/>
		<style>
			main {
				width: var(--content-width);
			}
			
			.archive-header {
				text-align: center;
				margin-bottom: var(--space-12);
				padding: var(--space-8);
				background: var(--color-paper-muted);
				border: 1px solid var(--border);
				border-radius: var(--radius-square);
			}
			
			.archive-header h1 {
				margin-bottom: var(--space-3);
				font-size: var(--text-h1);
			}
			
			.archive-header .stats {
				color: var(--footer-text);
				font-size: var(--text-base);
				line-height: var(--leading-ui);
				text-align: center;
				text-indent: 0;
			}
			
			details {
				margin-bottom: var(--space-8);
				background: transparent;
				border: 1px solid var(--border);
				border-radius: var(--radius-square);
				overflow: hidden;
				transition: border-color var(--duration-fast) ease;
			}

			details:hover,
			details[open] {
				border-color: var(--accent);
			}

			summary {
				padding: var(--space-5) var(--space-8);
				cursor: pointer;
				font-family: var(--font-display);
				font-size: var(--text-h3);
				font-weight: 600;
				color: var(--heading-color);
				user-select: none;
				transition: background-color var(--duration-fast) ease;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			summary:focus-visible {
				outline: var(--focus-ring);
				outline-offset: -2px;
			}
			
			summary::-webkit-details-marker {
				display: none;
			}
			
			summary::after {
				content: '+';
				color: var(--accent);
				font-family: var(--font-mono);
				font-size: var(--text-base);
				transition: transform var(--duration-base) var(--ease-standard);
			}
			
			details[open] summary::after {
				content: '-';
				transform: rotate(180deg);
			}
			
			.post-item {
				display: flex;
				align-items: center;
				gap: var(--space-3);
				padding: var(--space-3) var(--space-8);
				text-decoration: none;
				color: var(--text-color);
			}
			.post-line {
				flex: 1;
				min-width: var(--space-5);
				height: 1px;
				background: var(--border-color);
				transition: background-color var(--duration-fast) ease;
			}
			.post-item:hover .post-line {
				background: var(--accent);
			}
			.post-title {
				font-size: 1.125rem;
				line-height: var(--leading-ui);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				flex-shrink: 1;
				min-width: 0;
			}
			.post-date {
				color: var(--text-muted);
				font-size: var(--text-small);
				font-weight: 500;
				font-variant-numeric: tabular-nums;
				letter-spacing: var(--tracking-label);
				white-space: nowrap;
				flex-shrink: 0;
				transition: color var(--duration-fast) ease;
			}
			.post-item:hover .post-date {
				color: var(--accent);
			}
			
			.month-badge {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: var(--space-1) var(--space-2);
				background: transparent;
				color: var(--accent-dark);
				border: 1px solid var(--border);
				border-radius: var(--radius-control);
				font-family: var(--font-mono);
				font-size: var(--text-small);
				font-weight: 500;
				letter-spacing: 0.04em;
				margin-right: var(--space-3);
			}
			


			.post-count {
				color: var(--footer-text);
				font-size: var(--text-small);
				font-weight: 500;
			}
			
			@media (max-width: 720px) {
				.archive-header h1 {
					font-size: 2rem;
				}
				
				.archive-header .stats {
					font-size: 1rem;
				}
				
				summary {
					font-size: var(--text-lead);
					padding: var(--space-4) var(--space-5);
				}
				
				.post-item {
					padding: var(--space-3) var(--space-5);
				}
				.post-title {
					font-size: var(--text-base);
					line-height: 1.5;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}
				.post-date {
					font-size: var(--text-caption);
				}
			}
		</style>
	</head>
	<body data-motion-page="archive">
		<SiteShell>
			<section>
				<div class="archive-header" data-motion-archive-header data-motion-frame>
					<h1>文章归档</h1>
					<p class="stats">
						共有文章：{totalPosts} 篇，最后更新于 <FormattedDate date={lastUpdated} />
					</p>
				</div>
				
				{sortedMonths.map((month, index) => (
					<details name="archive" open={index === 0} data-motion-month data-motion-frame>
						<summary>
							<span>
								<span class="month-badge">{month}</span>
								<span class="post-count">{postsByMonth[month].length} 篇文章</span>
							</span>
						</summary>
						{postsByMonth[month].map((post) => (
							<a href={`/blog/${post.id}`} class="post-item" >
								<span class="post-title">{post.title}</span>
								<div class="post-line"></div>
								<time class="post-date">{formatDateMedium(post.time)}</time>
							</a>
						))}
					</details>
				))}
			</section>
		</SiteShell>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

---
import BaseHead from '../components/BaseHead.astro';
import SiteShell from '../components/SiteShell.astro';
import PostActions from '../components/PostActions.astro';
import { Icon } from 'astro-icon/components';
import {
	PROJECTS,
	PROJECTS_PAGE_TITLE,
	PROJECTS_PAGE_DESCRIPTION,
	SITE_DESCRIPTION,
	SITE_TITLE
} from '../consts';

const pageTitle = PROJECTS_PAGE_TITLE;
const pageDescription = PROJECTS_PAGE_DESCRIPTION;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${pageTitle} | ${SITE_TITLE}`}
			description={`${SITE_DESCRIPTION} - ${pageDescription}`}
			motionMode="full"
		/>
		<style>
			main {
				width: 720px;
			}

			section {
				margin-bottom: 3rem;
			}

			hgroup {
				margin-bottom: 2rem;
				padding: 2rem;
				background: transparent;
				border: 1px solid var(--border);
				border-radius: 0;
			}

			hgroup h2 {
				font-size: 1.75rem;
				margin-bottom: 0.75rem;
				color: var(--heading-color);
			}

			hgroup p {
				color: var(--footer-text);
				font-size: 1rem;
				line-height: 1.6;
			}

			.project-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.project-card {
				position: relative;
				padding: 1.25rem;
				background: transparent;
				border: 1px solid var(--border);
				border-radius: 0;
				transition: transform 0.2s ease, border-color 0.2s ease;
				overflow: hidden;
			}

			.project-card:hover,
			.project-card:focus-within {
				transform: translateY(-2px);
				border-color: var(--accent);
			}

			.project-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.5rem;
			}

			.project-name {
				font-size: 1.1rem;
				font-weight: 600;
				color: var(--heading-color);
			}

			.project-desc {
				color: var(--footer-text);
				font-size: 0.85rem;
				line-height: 1.5;
				margin: 0 0 0.75rem 0;
			}

			.project-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.5rem;
			}

			.project-meta:last-child {
				margin-bottom: 0;
			}

			.meta-label {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				color: var(--text-muted);
				font-size: 0.78rem;
				flex-shrink: 0;
			}

			.meta-items {
				display: inline-flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.4rem;
				min-width: 0;
			}

			.repo-link,
			.demo-link {
				display: inline-flex;
				align-items: center;
				gap: 0.2rem;
				max-width: 100%;
				padding: 0.15rem 0.5rem;
				background: rgba(var(--black), 5%);
				border-radius: 4px;
				font-size: 0.78rem;
				color: var(--text-color);
				text-decoration: none;
				overflow-wrap: anywhere;
				transition: background-color 0.2s ease, color 0.2s ease;
			}

			.repo-link:hover,
			.repo-link:focus-visible,
			.demo-link:hover,
			.demo-link:focus-visible {
				background: var(--accent);
				color: var(--accent-text);
			}

			@media (max-width: 720px) {
				hgroup {
					padding: 1.5rem;
				}

				hgroup h2 {
					font-size: 1.5rem;
				}

				.project-card {
					padding: 1rem;
				}

				.project-name {
					font-size: 1rem;
				}

				.project-desc {
					font-size: 0.8rem;
				}
			}
		</style>
	</head>
	<body data-motion-page="projects">
		<SiteShell>
			<section>
				<article>
					<hgroup data-motion-frame data-motion-project-header>
						<h2>
							<span class="sr-only">{pageTitle}</span>
							<span aria-hidden="true" data-typewriter>{pageTitle}</span>
						</h2>
						<p>
							<span class="sr-only">{pageDescription}</span>
							<span aria-hidden="true" data-typewriter>{pageDescription}</span>
						</p>
					</hgroup>
					<ul class="project-list">
						{PROJECTS.map(project => (
							<li class="project-card" data-motion-item data-motion-project-card>
								<div class="project-header">
									<Icon name="mdi:folder-open" width={20} height={20} aria-hidden="true" />
									<span class="project-name">
										<span class="sr-only">{project.name}</span>
										<span aria-hidden="true" data-typewriter>{project.name}</span>
									</span>
								</div>
								<p class="project-desc">{project.description}</p>

								<div class="project-meta">
									<span class="meta-label">
										<Icon name="mdi:source-repository" width={14} height={14} aria-hidden="true" />
										仓库
									</span>
									<span class="meta-items">
										{project.repoUrls.map(repo => (
											<a href={repo.url} target="_blank" rel="noopener noreferrer" class="repo-link">
												<Icon name={repo.label === 'GitHub' ? 'mdi:github' : 'mdi:source-repository'} width={13} height={13} aria-hidden="true" />
												{repo.label}
											</a>
										))}
									</span>
								</div>

								{project.demoUrl && (
									<div class="project-meta">
										<span class="meta-label">
											<Icon name="mdi:rocket" width={14} height={14} aria-hidden="true" />
											演示
										</span>
										<span class="meta-items">
											<a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="demo-link">
												<Icon name="mdi:open-in-new" width={13} height={13} aria-hidden="true" />
												{project.demoUrl}
											</a>
										</span>
									</div>
								)}
							</li>
						))}
					</ul>
				</article>
			</section>
			<hr aria-hidden="true" />
			<PostActions postId="projects" postPath="/projects" />
		</SiteShell>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

---
import BaseHead from '../components/BaseHead.astro';
import SiteShell from '../components/SiteShell.astro';
import PostActions from '../components/PostActions.astro';
import { Icon } from 'astro-icon/components';
import {
	PROJECTS,
	PROJECTS_PAGE_TITLE,
	PROJECTS_PAGE_DESCRIPTION,
	SITE_DESCRIPTION,
	SITE_TITLE
} from '../consts';

const pageTitle = PROJECTS_PAGE_TITLE;
const pageDescription = PROJECTS_PAGE_DESCRIPTION;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${pageTitle} | ${SITE_TITLE}`}
			description={`${SITE_DESCRIPTION} - ${pageDescription}`}
			motionMode="full"
		/>
		<style>
			main {
				width: var(--content-width);
			}

			section {
				margin-bottom: var(--space-12);
			}

			hgroup {
				margin-bottom: var(--space-8);
				padding: var(--space-8);
				background: var(--color-paper-muted);
				border: 1px solid var(--border);
				border-radius: var(--radius-square);
			}

			hgroup h2 {
				font-size: var(--text-h2);
				margin-bottom: var(--space-3);
				color: var(--heading-color);
			}

			hgroup p {
				color: var(--footer-text);
				font-size: var(--text-base);
				line-height: var(--leading-ui);
				text-align: left;
				text-indent: 0;
			}

			.project-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: var(--space-4);
			}

			.project-card {
				position: relative;
				padding: var(--space-6);
				background: var(--color-paper);
				border: 1px solid var(--border);
				border-radius: var(--radius-square);
				transition:
					border-color var(--duration-fast) ease,
					background-color var(--duration-fast) ease;
				overflow: hidden;
			}

			.project-card:hover,
			.project-card:focus-within {
				border-color: var(--accent);
				background: color-mix(in srgb, var(--color-paper-muted) 48%, var(--color-paper));
			}

			.project-header {
				display: flex;
				align-items: center;
				gap: var(--space-2);
				margin-bottom: var(--space-2);
			}

			.project-header svg {
				color: var(--accent);
			}

			.project-name {
				font-family: var(--font-display);
				font-size: 1.125rem;
				font-weight: 600;
				color: var(--heading-color);
			}

			.project-desc {
				color: var(--text-soft);
				font-size: var(--text-small);
				line-height: var(--leading-ui);
				margin: 0 0 var(--space-4) 0;
			}

			.project-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: var(--space-3);
				margin-bottom: var(--space-2);
			}

			.project-meta:last-child {
				margin-bottom: 0;
			}

			.meta-label {
				display: inline-flex;
				align-items: center;
				gap: var(--space-1);
				color: var(--text-muted);
				font-size: var(--text-caption);
				flex-shrink: 0;
			}

			.meta-items {
				display: inline-flex;
				flex-wrap: wrap;
				align-items: center;
				gap: var(--space-2);
				min-width: 0;
			}

			.repo-link,
			.demo-link {
				display: inline-flex;
				align-items: center;
				gap: var(--space-1);
				max-width: 100%;
				padding: var(--space-1) var(--space-2);
				background: transparent;
				border: 1px solid var(--border);
				border-radius: var(--radius-control);
				font-size: var(--text-caption);
				color: var(--text-soft);
				text-decoration-color: transparent;
				overflow-wrap: anywhere;
				transition:
					background-color var(--duration-fast) ease,
					border-color var(--duration-fast) ease,
					color var(--duration-fast) ease;
			}

			.repo-link:hover,
			.repo-link:focus-visible,
			.demo-link:hover,
			.demo-link:focus-visible {
				background: var(--accent-soft);
				border-color: var(--accent);
				color: var(--accent-dark);
			}

			@media (max-width: 720px) {
				hgroup {
					padding: var(--space-6);
				}

				hgroup h2 {
					font-size: var(--text-h3);
				}

				.project-card {
					padding: var(--space-5);
				}

				.project-name {
					font-size: var(--text-base);
				}

				.project-desc {
					font-size: var(--text-small);
				}
			}
		</style>
	</head>
	<body data-motion-page="projects">
		<SiteShell>
			<section>
				<article>
					<hgroup data-motion-frame data-motion-project-header>
						<h2>
							<span class="sr-only">{pageTitle}</span>
							<span aria-hidden="true" data-typewriter>{pageTitle}</span>
						</h2>
						<p>
							<span class="sr-only">{pageDescription}</span>
							<span aria-hidden="true" data-typewriter>{pageDescription}</span>
						</p>
					</hgroup>
					<ul class="project-list">
						{PROJECTS.map(project => (
							<li class="project-card" data-motion-item data-motion-project-card>
								<div class="project-header">
									<Icon name="mdi:folder-open" width={20} height={20} aria-hidden="true" />
									<span class="project-name">
										<span class="sr-only">{project.name}</span>
										<span aria-hidden="true" data-typewriter>{project.name}</span>
									</span>
								</div>
								<p class="project-desc">{project.description}</p>

								<div class="project-meta">
									<span class="meta-label">
										<Icon name="mdi:source-repository" width={14} height={14} aria-hidden="true" />
										仓库
									</span>
									<span class="meta-items">
										{project.repoUrls.map(repo => (
											<a href={repo.url} target="_blank" rel="noopener noreferrer" class="repo-link">
												<Icon name={repo.label === 'GitHub' ? 'mdi:github' : 'mdi:source-repository'} width={13} height={13} aria-hidden="true" />
												{repo.label}
											</a>
										))}
									</span>
								</div>

								{project.demoUrl && (
									<div class="project-meta">
										<span class="meta-label">
											<Icon name="mdi:rocket" width={14} height={14} aria-hidden="true" />
											演示
										</span>
										<span class="meta-items">
											<a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="demo-link">
												<Icon name="mdi:open-in-new" width={13} height={13} aria-hidden="true" />
												{project.demoUrl}
											</a>
										</span>
									</div>
								)}
							</li>
						))}
					</ul>
				</article>
			</section>
			<hr aria-hidden="true" />
			<PostActions postId="projects" postPath="/projects" />
		</SiteShell>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

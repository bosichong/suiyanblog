---
interface Props {
	date: string | Date;
	typewriter?: boolean;
}

const { date, typewriter = false } = Astro.props;

// 解析时间，支持 ISO 字符串或 Date 对象
const dateObj = typeof date === 'string' ? new Date(date) : date;
---

<time
	datetime={dateObj.toISOString()}
	data-typewriter={typewriter || undefined}
	data-typewriter-reserve={typewriter || undefined}
>
	{
		dateObj.toLocaleDateString('zh-CN', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	}
</time>
---
---

<div class="paper-damage" data-paper-damage aria-hidden="true">
	<div class="paper-damage__random" data-paper-damage-random></div>
</div>

<script>
	import '../scripts/paper-damage';
</script>

<style is:global>
	.main-container {
		isolation: isolate;
	}

	.paper-damage {
		--paper-damage-void: var(--color-canvas);
		--paper-damage-back: #e9e2d6;
		--paper-damage-edge: #a99d8c;
		--paper-damage-deep: #786f62;
		--paper-damage-fiber: #8f8576;
		--paper-damage-highlight: rgba(255, 255, 255, 0.72);
		position: absolute;
		inset: 0;
		z-index: 2;
		overflow: hidden;
		pointer-events: none;
		user-select: none;
		contain: layout style paint;
	}

	.paper-damage__random {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.paper-damage__item {
		position: absolute;
		overflow: visible;
		pointer-events: none;
		transform: translateZ(0);
	}

	.paper-damage__graphic {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		transform: scaleX(var(--paper-damage-flip, 1));
		transform-origin: center;
	}

	.paper-damage__graphic > svg {
		overflow: visible;
	}

	.paper-damage__void {
		fill: var(--paper-damage-void);
	}

	.paper-damage__shadow {
		fill: none;
		stroke: rgba(48, 42, 35, var(--paper-damage-shadow, 0.18));
		stroke-width: 7;
		stroke-linecap: round;
		stroke-linejoin: round;
		filter: blur(2.4px);
	}

	.paper-damage__edge-shadow {
		fill: none;
		stroke: rgba(48, 42, 35, var(--paper-damage-shadow, 0.18));
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.paper-damage__paper-edge {
		fill: none;
		stroke: var(--paper-damage-edge);
		stroke-width: 0.95;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.78;
	}

	.paper-damage__back-edge {
		fill: none;
		stroke: var(--paper-damage-back);
		stroke-width: 2.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.82;
	}

	.paper-damage__highlight-edge {
		fill: none;
		stroke: var(--paper-damage-highlight);
		stroke-width: 0.68;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.52;
	}

	.paper-damage__crack-shadow {
		fill: none;
		stroke: rgba(52, 45, 37, 0.16);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
		filter: blur(0.7px);
		transform: translateY(0.7px);
	}

	.paper-damage__crack-line {
		fill: none;
		stroke: var(--paper-damage-deep);
		stroke-width: 1;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.72;
	}

	.paper-damage__crack-highlight {
		fill: none;
		stroke: rgba(255, 255, 255, 0.66);
		stroke-width: 0.65;
		stroke-linecap: round;
		stroke-linejoin: round;
		transform: translate(-0.35px, -0.45px);
		opacity: 0.62;
	}

	.paper-damage__fibers {
		fill: none;
		stroke: var(--paper-damage-fiber);
		stroke-width: 0.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.58;
	}

	.paper-damage__flake {
		fill: var(--paper-damage-back);
		stroke: var(--paper-damage-edge);
		stroke-width: 0.78;
		stroke-linecap: round;
		stroke-linejoin: round;
		transform-box: fill-box;
		transform-origin: left center;
		transform:
			perspective(90px)
			rotateY(var(--paper-damage-lift-angle, -5deg))
			translateX(0);
		filter: drop-shadow(1px 2px 1.2px rgba(55, 47, 38, 0.18));
	}

	.paper-damage__flake-fold {
		fill: none;
		stroke: rgba(100, 87, 71, 0.32);
		stroke-width: 0.55;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.paper-damage__item.is-revealing .paper-damage__crack-line,
	.paper-damage__item.is-revealing .paper-damage__crack-shadow,
	.paper-damage__item.is-revealing .paper-damage__crack-highlight {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: paper-damage-line-open 440ms cubic-bezier(0.3, 0.72, 0.18, 1)
			both;
	}

	.paper-damage__item.is-revealing .paper-damage__void,
	.paper-damage__item.is-revealing .paper-damage__back-edge,
	.paper-damage__item.is-revealing .paper-damage__paper-edge,
	.paper-damage__item.is-revealing .paper-damage__highlight-edge {
		animation: paper-damage-opening 460ms 120ms cubic-bezier(0.25, 0.72, 0.2, 1)
			both;
	}

	.paper-damage__item.is-revealing .paper-damage__shadow,
	.paper-damage__item.is-revealing .paper-damage__edge-shadow {
		animation: paper-damage-shadow-in 520ms 200ms ease both;
	}

	.paper-damage__item.is-revealing .paper-damage__fibers {
		animation: paper-damage-fibers-in 340ms 310ms ease both;
	}

	.paper-damage__item--lift.is-revealing .paper-damage__flake {
		animation: paper-damage-flake-lift 560ms 220ms cubic-bezier(0.2, 0.74, 0.22, 1)
			both;
	}

	.paper-damage__item--lift.is-revealing .paper-damage__flake-fold {
		animation: paper-damage-fibers-in 280ms 460ms ease both;
	}

	@keyframes paper-damage-line-open {
		0% {
			opacity: 0;
			stroke-dashoffset: 1;
		}
		18% {
			opacity: 0.72;
		}
		100% {
			opacity: 1;
			stroke-dashoffset: 0;
		}
	}

	@keyframes paper-damage-opening {
		0% {
			opacity: 0;
			transform: scale(0.965);
		}
		42% {
			opacity: 0.78;
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes paper-damage-shadow-in {
		0% {
			opacity: 0;
			transform: translate(-0.6px, -0.35px);
		}
		100% {
			opacity: 1;
			transform: translate(0, 0);
		}
	}

	@keyframes paper-damage-fibers-in {
		0% {
			opacity: 0;
		}
		100% {
			opacity: 0.58;
		}
	}

	@keyframes paper-damage-flake-lift {
		0% {
			opacity: 0;
			transform:
				perspective(90px)
				rotateY(0deg)
				translateX(-2px);
		}
		42% {
			opacity: 0.8;
		}
		100% {
			opacity: 1;
			transform:
				perspective(90px)
				rotateY(var(--paper-damage-lift-angle, -5deg))
				translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.paper-damage__item.is-revealing .paper-damage__crack-line,
		.paper-damage__item.is-revealing .paper-damage__crack-shadow,
		.paper-damage__item.is-revealing .paper-damage__crack-highlight,
		.paper-damage__item.is-revealing .paper-damage__void,
		.paper-damage__item.is-revealing .paper-damage__back-edge,
		.paper-damage__item.is-revealing .paper-damage__paper-edge,
		.paper-damage__item.is-revealing .paper-damage__highlight-edge,
		.paper-damage__item.is-revealing .paper-damage__shadow,
		.paper-damage__item.is-revealing .paper-damage__edge-shadow,
		.paper-damage__item.is-revealing .paper-damage__fibers,
		.paper-damage__item.is-revealing .paper-damage__flake,
		.paper-damage__item.is-revealing .paper-damage__flake-fold {
			animation: none !important;
			opacity: 1;
			stroke-dashoffset: 0;
		}
	}
</style>

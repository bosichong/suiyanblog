---
import { slugify } from '../utils/slugify';

interface Props {
	tags: string[];
	showLabel?: boolean;
	limit?: number;
	typewriter?: boolean;
}

const { tags, showLabel = false, limit, typewriter = false } = Astro.props;
const displayTags = limit ? tags.slice(0, limit) : tags;
const hasMoreTags = limit && tags.length > limit;
---

<div class="tag-list">
	{showLabel && (
		<span class="tag-label">
			{typewriter ? (
				<span data-typewriter data-typewriter-reserve>Tags:</span>
			) : (
				'Tags:'
			)}
		</span>
	)}
	<ul class="tags">
		{displayTags.map((tag) => (
			<li class="tag" data-motion-article-tag={typewriter || undefined}>
				<a href={`/tags/${slugify(tag)}`} class="tag-link">
					{typewriter ? (
						<span data-typewriter data-typewriter-reserve>{tag}</span>
					) : (
						tag
					)}
				</a>
			</li>
		))}
		{hasMoreTags && (
			<li class="tag-more">
				+{tags.length - limit!} more
			</li>
		)}
	</ul>
</div>

<style>
	.tag-list {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
		margin: var(--space-2) 0;
	}

	.tag-label {
		font-size: var(--text-small);
		font-weight: 600;
		color: var(--color-ink-muted);
		margin-right: var(--space-1);
		letter-spacing: var(--tracking-label);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tag {
		margin: 0;
	}

	.tag-link {
		display: inline-block;
		padding: var(--space-1) var(--space-3);
		background: transparent;
		color: var(--text-soft);
		border-radius: var(--radius-pill);
		font-size: var(--text-small);
		font-weight: 500;
		border: 1px solid var(--border);
		text-decoration-color: transparent;
		transition:
			color var(--duration-fast) ease,
			border-color var(--duration-fast) ease,
			background-color var(--duration-fast) ease;
	}

	.tag-link:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent-dark);
	}

	.tag-link:focus-visible {
		outline: var(--focus-ring);
		outline-offset: 2px;
	}

	.tag-more {
		display: inline-block;
		padding: var(--space-1) var(--space-3);
		background: transparent;
		border: 1px solid var(--border);
		color: var(--text-muted);
		border-radius: var(--radius-pill);
		font-size: var(--text-small);
		font-style: italic;
	}

	/* Responsive adjustments */
	@media (max-width: 720px) {
		.tag-list {
			gap: var(--space-1);
		}
		
		.tags {
			gap: var(--space-1);
		}
		
		.tag-link {
			padding: 0.1875rem 0.625rem;
			font-size: var(--text-caption);
		}
	}
</style>

---
import { Icon } from 'astro-icon/components';

interface Props {
	level?: number;
}

const { level = 0 } = Astro.props;

const ICON_SIZE = 18;

const aiLevels = [
	{
		level: 0,
		icon: 'mdi:pencil',
		theme: 'HAND',
		zh: '手写',
		description: '每一个字都由作者亲手敲出',
	},
	{
		level: 1,
		icon: 'mdi:microphone',
		theme: 'VOICE',
		zh: '口述',
		description: '语音转文字，AI 负责修正',
	},
	{
		level: 2,
		icon: 'mdi:auto-fix',
		theme: 'POLISH',
		zh: '润色',
		description: '核心由作者完成，AI 辅助',
	},
	{
		level: 3,
		icon: 'mdi:hand-wave',
		theme: 'DUET',
		zh: '协奏',
		description: '人与 AI 共创，互相启发',
	},
	{
		level: 4,
		icon: 'mdi:robot',
		theme: 'AUTO',
		zh: '自动',
		description: 'AI 主导生成，人类审核',
	},
];

const aiInfo = aiLevels.find((item) => item.level === level) || aiLevels[0];
---

<span class="ai-badge" data-tooltip={`${aiInfo.zh}·${aiInfo.description}`}>
	<Icon name={aiInfo.icon} width={ICON_SIZE} height={ICON_SIZE} aria-hidden="true" />
	<span class="ai-theme" data-typewriter data-typewriter-reserve>{aiInfo.zh}</span>
</span>

<style>
	.ai-badge {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-1) var(--space-3);
		font-size: var(--text-caption);
		font-weight: 500;
		color: var(--accent-dark);
		background: transparent;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		vertical-align: middle;
		cursor: help;
		transition:
			border-color var(--duration-fast) ease,
			background-color var(--duration-fast) ease;
	}

	.ai-badge svg {
		color: var(--accent);
	}

	.ai-badge:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	/* CSS-only tooltip */
	.ai-badge::after {
		content: attr(data-tooltip);
		position: absolute;
		bottom: calc(100% + var(--space-2));
		left: 50%;
		transform: translateX(-50%) translateY(4px);
		padding: var(--space-2) var(--space-3);
		font-size: var(--text-caption);
		font-weight: 400;
		font-style: italic;
		color: var(--text);
		background: var(--color-paper);
		border: 1px solid var(--border);
		border-radius: var(--radius-control);
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		box-shadow: var(--shadow-control);
		transition:
			opacity var(--duration-fast) ease,
			transform var(--duration-fast) ease;
		z-index: 10;
	}

	.ai-badge::before {
		content: "";
		position: absolute;
		bottom: calc(100% + 1px);
		left: 50%;
		transform: translateX(-50%) translateY(4px);
		border: 6px solid transparent;
		border-top-color: var(--border);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity var(--duration-fast) ease,
			transform var(--duration-fast) ease;
		z-index: 10;
	}

	.ai-badge:hover::after,
	.ai-badge:hover::before,
	.ai-badge:focus::after,
	.ai-badge:focus::before {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}
</style>

---
import { Icon } from 'astro-icon/components';
import { SITE_TITLE_EN, SNS_LINKS } from '../consts';

interface Props {
	typewriter?: boolean;
}

const { typewriter = false } = Astro.props;
const today = new Date();
---

<footer data-motion-footer>
	<div class="footer-content">
		<div class="social-links">
			{SNS_LINKS.map(link => (
				<a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.name}>
					<Icon name={link.icon} width={20} height={20} aria-hidden="true" />
				</a>
			))}
		</div>
		<p class="footer-text">
			<span
				class="copyright"
				data-typewriter={typewriter || undefined}
				data-typewriter-reserve={typewriter || undefined}
			>&copy; 2017-{today.getFullYear()} {SITE_TITLE_EN}</span>
			<span class="divider">|</span>
			<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/?ref=chooser-v1" target="_blank" rel="license noopener noreferrer">
				<span data-typewriter={typewriter || undefined} data-typewriter-reserve={typewriter || undefined}>CC BY-NC-SA 4.0</span>
			</a>
		</p>
	</div>
	<script data-goatcounter="https://suiyan.goatcounter.com/count"
        async src="https://gc.zgo.at/count.js"></script>
</footer>
<style>
	footer {
		padding: var(--space-8) var(--space-4);
		background: transparent;
		color: var(--color-ink-muted);
		text-align: center;
	}
	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
	}
	.social-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: var(--space-1);
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--touch-target);
		height: var(--touch-target);
		text-decoration: none;
		color: var(--color-ink-muted);
		border-radius: var(--radius-pill);
		transition:
			color var(--duration-fast) ease,
			background-color var(--duration-fast) ease;
	}
	.social-links a:hover {
		background: var(--accent-soft);
		color: var(--accent-dark);
	}
	.footer-text {
		margin: 0;
		font-size: var(--text-small);
		line-height: var(--leading-ui);
		text-align: center;
		text-indent: 0;
		letter-spacing: 0.02em;
	}
	.divider {
		margin: 0 0.75rem;
	}
	.footer-text a {
		text-decoration: none;
		color: var(--color-ink-muted);
		transition: color var(--duration-fast) ease;
	}
	.footer-text a:hover {
		color: var(--accent-dark);
	}
</style>

---
import { COMMENTS_CONFIG } from '../consts';

interface Props {
	postId: string;
	postPath: string;
}

const { postId, postPath } = Astro.props;

// 将配置序列化为 JSON 供客户端使用
const commentsConfig = JSON.stringify(COMMENTS_CONFIG);
---

<div class="comment-section" id="comment-section" data-post-id={postId} data-post-path={postPath} data-config={commentsConfig}>
	<div class="comment-content" id="comment-content">
		<!-- 评论内容由 JS 动态加载 -->
	</div>
</div>

<style>
	.comment-section {
		margin: 2rem 0;
	}

	.comment-content {
		margin-top: 1rem;
		min-height: 0;
	}
</style>

<script>
	// ============================================================
	// 评论懒加载：使用 IntersectionObserver 监听评论区域，
	// 当用户滚动到评论区域附近时自动加载 Twikoo 评论。
	// ============================================================
	
	// ---------- 全局状态（跨导航重置） ----------
	window.__commentState = window.__commentState || { loaded: false, observer: null };
	
	// 视图过渡导航后重置状态，避免跨页面污染。
	// 同时清除 twikoo 全局实例，确保下次加载时重新初始化。
	document.addEventListener('astro:after-swap', () => {
		window.__commentState.loaded = false;
		if (window.__commentState.observer) {
			window.__commentState.observer.disconnect();
			window.__commentState.observer = null;
		}
		delete (window as any).twikoo;
		// 重新初始化观察器
		initObserver();
	});
	
	// ---------- 初始化 IntersectionObserver ----------
	function initObserver() {
		const content = document.getElementById('comment-content');
		const section = document.getElementById('comment-section');
		if (!content || !section) return;
		
		// 如果已经加载过，不再观察
		if (window.__commentState.loaded) return;
		
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting && !window.__commentState.loaded) {
					window.__commentState.loaded = true;
					observer.disconnect();
					
					// 获取配置
					const configStr = section.getAttribute('data-config') || '{}';
					const config = JSON.parse(configStr);
					const postPath = section.getAttribute('data-post-path') || '';
					
					loadTwikoo(content, config, postPath);
				}
			});
		}, {
			rootMargin: '200px 0px',
			threshold: 0
		});
		
		observer.observe(content);
		window.__commentState.observer = observer;
	}
	
	// ---------- 加载 Twikoo ----------
	function loadTwikoo(container: HTMLElement, config: any, path: string) {
		const twikooDiv = document.createElement('div');
		twikooDiv.id = 'twikoo-comment';
		twikooDiv.style.minHeight = '200px';
		container.appendChild(twikooDiv);
		
		const script = document.createElement('script');
		script.src = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.19/dist/twikoo.all.min.js';
		script.onload = () => {
			(window as any).twikoo?.init({
				envId: config.twikoo.envId,
				el: '#twikoo-comment',
				path: path
			});
		};
		document.head.appendChild(script);
	}
	
	// ---------- 页面加载时初始化 ----------
	initObserver();

</script>